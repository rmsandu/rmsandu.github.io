{% extends "base.jinja" %}

{% block page_title %}{{ title }} | Raluca-Maria Sandu{% endblock %}

{% block meta_description %}{{ subtitle }}{% endblock %}

{% block og_type %}article{% endblock %}

{% block og_image %}{% if coverImg %}{{ url_for('static', filename=coverImg, _external=True) }}{% else %}{{ super() }}{% endif %}{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | tojson }},
    "description": {{ subtitle | tojson }},
    {% if date %}"datePublished": {{ date.isoformat() | tojson }},{% endif %}
    "image": {{ (url_for('static', filename=coverImg, _external=True) if coverImg else "") | tojson }},
    "author": {
        "@type": "Person",
        "name": "Raluca-Maria Sandu"
    },
    "mainEntityOfPage": {{ canonical_url | tojson }}
}
</script>
{% endblock %}

{% block main %}
<article class="blog-post-page">
    <header class="blog-post-header">
        <div class="container blog-container">
            <p class="post-date">{{ date | format_date }}</p>
            <h1>{{ title }}</h1>
            <p class="blog-subtitle">{{ subtitle }}</p>

            {% if tags %}
            <div class="tag-list" aria-label="tags">
                {% for tag in tags %}
                <a class="tag-pill" href="{{ url_for('search_tag', tag=tag) }}">{{ tag }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </header>

    {% if coverImg %}
    <div class="container blog-container">
        <figure class="blog-cover">
            <img src="{{ url_for('static', filename=coverImg) }}" alt="{{ title }}">
        </figure>
    </div>
    {% endif %}

    <div class="section">
        <div class="container blog-container">
            <div class="content blog-content">
                {{ content | safe }}
            </div>
        </div>
    </div>
</article>
{% endblock %}
