{% if blogPosts %}
<div class="post-grid">
    {% for blogPost in blogPosts %}
    <article class="post-card">
        <a class="post-card-image" href="{{ url_for('render_blog_page', page_name=blogPost.filename) }}" aria-label="Read {{ blogPost.title | striptags }}">
            {% if blogPost.coverImg %}
            <img src="{{ url_for('static', filename=blogPost.coverImg) }}" alt="{{ blogPost.title | striptags }}">
            {% else %}
            <span>{{ blogPost.title | striptags }}</span>
            {% endif %}
        </a>

        <div class="post-card-body">
            <p class="post-date">{{ blogPost.date | format_date }}</p>
            <h2><a href="{{ url_for('render_blog_page', page_name=blogPost.filename) }}">{{ blogPost.title | striptags }}</a></h2>
            <p class="post-subtitle">{{ blogPost.subtitle | striptags }}</p>
            <p class="post-excerpt">{{ blogPost.content | striptags | truncate(180, True, '...') }}</p>

            {% if blogPost.tags %}
            <div class="tag-list" aria-label="tags">
                {% for tag in blogPost.tags %}
                <a class="tag-pill {{ 'is-selected' if selectedTag == tag else '' }}" href="{{ url_for('search_tag', tag=tag) }}">{{ tag }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </article>
    {% endfor %}
</div>
{% else %}
<div class="empty-state">
    <p>No posts found for this tag.</p>
    <a href="{{ url_for('blogList') }}">Show all blog posts</a>
</div>
{% endif %}
