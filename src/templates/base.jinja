<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ url_for('static', filename='img/favicon-32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ url_for('static', filename='img/favicon-16.png') }}">
    <link rel="apple-touch-icon" href="{{ url_for('static', filename='img/apple-touch-icon.png') }}">
    <link rel="alternate" type="application/rss+xml" title="Raluca-Maria Sandu — Blog" href="{{ url_for('feed', _external=True) }}">
    <meta name="description" content="{% block meta_description %}Raluca-Maria Sandu is an AI/ML engineer and researcher based in Zurich, Switzerland.{% endblock %}">
    <link rel="canonical" href="{{ canonical_url }}">

    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:title" content="{% block og_title %}{{ self.page_title() }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ self.meta_description() }}{% endblock %}">
    <meta property="og:image" content="{% block og_image %}{{ url_for('static', filename='img/portrait_scaled.jpg', _external=True) }}{% endblock %}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ self.og_title() }}">
    <meta name="twitter:description" content="{{ self.og_description() }}">
    <meta name="twitter:image" content="{{ self.og_image() }}">

    {% block structured_data %}{% endblock %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/main.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/codehilite.css') }}">
    <title>{% block page_title %}Raluca-Maria Sandu{% endblock %}</title>

    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "fe3aa52662974edc971cc97c933cae89"}'></script>
    <!-- End Cloudflare Web Analytics -->
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <nav class="site-sidebar" aria-label="page sections">
        <a href="{{ url_for('index') }}"><i class="fas fa-home" aria-hidden="true"></i>Home</a>
        <a href="{{ url_for('index') }}#timeline"><i class="fas fa-file-alt" aria-hidden="true"></i>Resume</a>
        <a href="{{ url_for('blogList') }}"><i class="fas fa-blog" aria-hidden="true"></i>Blog</a>
        <a href="{{ url_for('publications') }}"><i class="fas fa-book-open" aria-hidden="true"></i> Publications</a>
        <a href="{{ url_for('consulting') }}"><i class="fas fa-envelope" aria-hidden="true"></i> Contact</a>
    </nav>

    {% block site_header %}
    <header class="site-header">
        <nav class="site-nav" aria-label="main navigation">
            <a class="site-brand" href="{{ url_for('index') }}">Raluca-Maria Sandu</a>

            <button class="navbar-burger site-menu-button" type="button" aria-label="menu" aria-expanded="false"
                data-target="navbarBasicExample">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>

            <div id="navbarBasicExample" class="site-nav-links navbar-menu">
                <a href="{{ url_for('blogList') }}">Blog</a>
                <a href="{{ url_for('publications') }}">Publications</a>
                <a href="{{ url_for('consulting') }}">Consulting</a>
            </div>
        </nav>
    </header>
    {% endblock %}

    <main id="main-content">
        {% block main %}
        {% endblock %}
    </main>

    <footer class="footer site-footer">
        {% include 'partials/_footer.jinja' %}
    </footer>

    <script src="{{ url_for('static', filename='js/bulma.js') }}"></script>
</body>

</html>
